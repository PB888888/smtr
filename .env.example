# Paddock Blade social media management — configuration template.
#
# Copy this to .env and fill it in. NEVER commit .env; it is git-ignored.
#   cp .env.example .env
#
# SETUP.md explains where each value comes from, written for a non-developer.

# ---------------------------------------------------------------------------
# Meta credentials (required)
# ---------------------------------------------------------------------------

# Long-lived Page or User access token. The only mandatory value.
# SETUP.md section 4 covers generating one and exchanging it for a long-lived token.
META_ACCESS_TOKEN=

# App ID and secret from the App Dashboard.
# Optional, but supplying both enables two useful things:
#   - appsecret_proof signing, so a stolen token alone cannot be replayed
#   - token expiry reporting in meta_check_access
META_APP_ID=
META_APP_SECRET=

# ---------------------------------------------------------------------------
# Graph API version
# ---------------------------------------------------------------------------

# PROVISIONAL DEFAULT. This was triangulated from Meta's own published SDK and
# its release cadence, not read off the changelog — developers.facebook.com was
# unreachable from the build environment. Check the current version at
# https://developers.facebook.com/docs/graph-api/changelog and correct this if
# needed. Run the meta_check_access tool to confirm whatever you set here works.
META_GRAPH_API_VERSION=v26.0

# ---------------------------------------------------------------------------
# Accounts (optional but recommended)
# ---------------------------------------------------------------------------

# Comma-separated Facebook Page IDs the runner should sweep.
# Leave empty to process every Page the token can reach.
# Get these from the meta_list_pages tool.
PB_PAGE_IDS=

# Comma-separated Instagram Business account IDs.
# Also from meta_list_pages — each Page reports its linked Instagram account.
PB_IG_ACCOUNT_IDS=

# ---------------------------------------------------------------------------
# Escalation destination — Telegram
# ---------------------------------------------------------------------------

# Bot token from @BotFather. Treat this as a secret: anyone holding it can post
# as your bot. SETUP.md section 6 covers creating the bot and finding the chat ID.
PB_TELEGRAM_BOT_TOKEN=

# The chat to send review queues and escalations to. Your own user ID for a
# direct message, or a negative number for a group.
PB_TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Safety
# ---------------------------------------------------------------------------

# Dry run. When true, every write tool logs what it would have done and makes no
# API call. Leave this ON until you have watched a full cycle and are satisfied
# with what the queue contains.
META_DRY_RUN=true

# Where the append-only audit log is written, relative to the repository root.
META_AUDIT_LOG_PATH=logs/audit.jsonl

# Auto-send whitelist. SHIPS EMPTY AND DISABLED, and needs two separate changes
# to activate — this flag, and at least one entry in the categories list.
# Read runner/README.md on the risk before touching either.
PB_AUTOSEND_ENABLED=false
PB_AUTOSEND_CATEGORIES=
